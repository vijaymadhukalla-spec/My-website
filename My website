<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Consultant Portfolio</title>
    <script src="https://tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#0f172a',
                            accent: '#38bdf8',
                            muted: '#94a3b8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-[#0f172a] text-slate-100 font-sans antialiased">

    <!-- Header / Navigation -->
    <header class="sticky top-0 z-50 bg-[#0f172a]/80 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="text-xl font-bold tracking-tight text-white">
                Data<span class="text-[#38bdf8]">Consultant</span>
            </div>
            <nav class="flex space-x-8 text-sm font-medium">
                <a href="#services" class="text-slate-300 hover:text-[#38bdf8] transition">Services</a>
                <a href="#portfolio" class="text-slate-300 hover:text-[#38bdf8] transition">Portfolio</a>
                <a href="#contact" class="text-slate-300 hover:text-[#38bdf8] transition">Contact</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center lg:py-32">
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight max-w-3xl mx-auto leading-tight">
            Turning Raw Data Into <span class="text-[#38bdf8]">Actionable Strategy</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto">
            High-impact data engineering, customized analytics frameworks, and interactive business intelligence systems designed to accelerate your growth.
        </p>
        <div class="mt-10 flex justify-center space-x-4">
            <a href="#contact" class="bg-[#38bdf8] text-[#0f172a] px-6 py-3 rounded-lg font-semibold hover:bg-sky-400 transition shadow-lg shadow-sky-500/20">
                Book a Consultation
            </a>
            <a href="#portfolio" class="border border-slate-700 text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">
                View My Work
            </a>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="border-t border-slate-800 bg-slate-900/50 py-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-bold text-white sm:text-4xl">Expert Data Services</h2>
                <p class="mt-4 text-slate-400">Tailored data infrastructure solutions to solve your specific operational bottlenecks.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="bg-[#0f172a] p-8 rounded-xl border border-slate-800 hover:border-slate-700 transition">
                    <div class="w-12 h-12 rounded-lg bg-sky-500/10 flex items-center justify-center text-[#38bdf8] mb-6 font-bold text-xl">01</div>
                    <h3 class="text-xl font-bold text-white mb-3">Data Engineering</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Robust ETL/ELT pipelines, automated integrations, and cloud data warehousing designed for scale and reliability.</p>
                </div>
                <!-- Service 2 -->
                <div class="bg-[#0f172a] p-8 rounded-xl border border-slate-800 hover:border-slate-700 transition">
                    <div class="w-12 h-12 rounded-lg bg-sky-500/10 flex items-center justify-center text-[#38bdf8] mb-6 font-bold text-xl">02</div>
                    <h3 class="text-xl font-bold text-white mb-3">Business Intelligence</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Interactive, beautiful executive dashboards (Power BI / Tableau) built to drive operational decision making.</p>
                </div>
                <!-- Service 3 -->
                <div class="bg-[#0f172a] p-8 rounded-xl border border-slate-800 hover:border-slate-700 transition">
                    <div class="w-12 h-12 rounded-lg bg-sky-500/10 flex items-center justify-center text-[#38bdf8] mb-6 font-bold text-xl">03</div>
                    <h3 class="text-xl font-bold text-white mb-3">Analytics & Insights</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Statistical deep dives, predictive performance models, and custom data audits to unearth hidden inefficiencies.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio" class="border-t border-slate-800 py-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-bold text-white sm:text-4xl">Featured Case Studies</h2>
                <p class="mt-4 text-slate-400">Real projects demonstrating data pipeline efficiency and strategic insights.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Project 1 -->
                <div class="group bg-slate-950 rounded-xl overflow-hidden border border-slate-800 hover:border-slate-700 transition">
                    <div class="h-48 bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center text-slate-500 group-hover:from-slate-700 transition">
                        <span>[ Interactive Dashboard Screenshot / Mockup ]</span>
                    </div>
                    <div class="p-6">
                        <span class="text-xs font-semibold tracking-wider text-[#38bdf8] uppercase">Power BI & SQL</span>
                        <h3 class="text-xl font-bold text-white mt-2 mb-3">Operational Performance Dashboard</h3>
                        <p class="text-slate-400 text-sm mb-4">Consolidated disparate operational metrics from 3 systems into a real-time management dashboard, saving 15 hours of manual reporting per week.</p>
                    </div>
                </div>
                <!-- Project 2 -->
                <div class="group bg-slate-950 rounded-xl overflow-hidden border border-slate-800 hover:border-slate-700 transition">
                    <div class="h-48 bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center text-slate-500 group-hover:from-slate-700 transition">
                        <span>[ Pipeline Architecture Diagram ]</span>
                    </div>
                    <div class="p-6">
                        <span class="text-xs font-semibold tracking-wider text-[#38bdf8] uppercase">Python & Cloud Architecture</span>
                        <h3 class="text-xl font-bold text-white mt-2 mb-3">Automated Recruitment Analytics Pipeline</h3>
                        <p class="text-slate-400 text-sm mb-4">Engineered a serverless data pipeline ingestion layer mapping applicant profiles to target roles, speeding up evaluation pipelines by 40%.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="border-t border-slate-800 bg-slate-900/50 py-24">
        <div class="max-w-xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-white">Let's Discuss Your Project</h2>
                <p class="mt-3 text-slate-400">Ready to unlock your data's potential? Send a message below.</p>
            </div>
            <form action="#" method="POST" class="space-y-6">
                <div>
                    <label for="name" class="block text-sm font-medium text-slate-300">Name</label>
                    <input type="text" id="name" name="name" required class="mt-1 block w-full rounded-lg bg-[#0f172a] border border-slate-800 text-white px-4 py-3 focus:outline-none focus:border-[#38bdf8] transition text-sm">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-slate-300">Email Address</label>
                    <input type="email" id="email" name="email" required class="mt-1 block w-full rounded-lg bg-[#0f172a] border border-slate-800 text-white px-4 py-3 focus:outline-none focus:border-[#38bdf8] transition text-sm">
                </div>
                <div>
                    <label for="message" class="block text-sm font-medium text-slate-300">Message</label>
                    <textarea id="message" name="message" rows="4" required class="mt-1 block w-full rounded-lg bg-[#0f172a] border border-slate-800 text-white px-4 py-3 focus:outline-none focus:border-[#38bdf8] transition text-sm"></textarea>
                </div>
                <button type="submit" class="w-full bg-[#38bdf8] text-[#0f172a] py-3 rounded-lg font-semibold hover:bg-sky-400 transition text-sm shadow-md">
                    Send Message
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-slate-900 bg-slate-950 py-8 text-center text-xs text-slate-500">
        <p>&copy; 2026 Data Consultant Portfolio. All rights reserved.</p>
    </footer>

</body>
</html>
